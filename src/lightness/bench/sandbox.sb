(version 1)
; Sandbox for agent-issued commands and for hidden tests running agent-written code.
; Reads: nothing under $HOME except the run dir, the bench venv, and the lightness package
;   (keeps hidden tests/solutions/other runs unreadable and avoids macOS privacy prompts).
; Writes: only inside the run dir. Network: outbound only to localhost.
(allow default)

(deny file-read* (subpath (param "HOME")))
(allow file-read-metadata)
(allow file-read*
  (subpath (param "RUN_DIR"))
  (subpath (string-append (param "REPO") "/.venv"))
  (subpath (string-append (param "REPO") "/src")))

(deny file-write*)
(allow file-write*
  (subpath (param "RUN_DIR"))
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/tty")
  (regex #"^/dev/fd/"))

; Outbound only to localhost (model server, apps under test). Binding/listening stays allowed.
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
